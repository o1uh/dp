FROM nvidia/cuda:11.8.0-base-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && \
    apt-get install -y python3.10 python3-pip ffmpeg libsndfile1 && \
    rm -rf /var/lib/apt/lists/*

RUN ln -s /usr/bin/python3.10 /usr/bin/python

WORKDIR /app

COPY requirements.worker.txt .
RUN pip install --no-cache-dir -r requirements.worker.txt --extra-index-url https://download.pytorch.org/whl/cu118 

COPY src/ src/

CMD ["celery", "-A", "src.worker.celery_app", "worker", "--loglevel=info", "--concurrency=1"]